/**
 * Upgrade function
 * @param int $oldversion
 * @return bool
 */
function xmldb_assignsubmission_responsetemplate_upgrade($oldversion) {
    global $DB;
    $dbman = $DB->get_manager();

    if ($oldversion < 2026040602) { // Match the new version.
        $table = new xmldb_table('assign_submission_resptemp');
        $field = new xmldb_field('fullscreen', XMLDB_TYPE_INTEGER, '2', null, XMLDB_NOTNULL, null, '0', 'templateformat');

        if (!$dbman->field_exists($table, $field)) {
            $dbman->add_field($table, $field);
        }

        upgrade_plugin_savepoint(true, 2026040602, 'assignsubmission', 'responsetemplate');
    }
    return true;
}